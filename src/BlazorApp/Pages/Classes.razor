@page "/classes"

<SeoHead Title="Online Bansuri Classes | Beginner to Advanced Lessons"
         Description="Personalized online Bansuri classes for beginner, intermediate, and advanced students of Hindustani classical flute."
         CanonicalUrl="https://flutewithkuldeep.com/classes" />

<div class="seo-page-shell">
    <header class="seo-page-header">
        <nav class="seo-page seo-page-nav" aria-label="Main navigation">
            <NavLink href="">Home</NavLink>
            <NavLink href="about">About</NavLink>
            <NavLink href="faq">FAQ</NavLink>
            <NavLink href="contact">Contact</NavLink>
        </nav>
    </header>

    <main class="seo-page seo-page-main">
        <h1>Online Bansuri Classes</h1>
        <p>
            Learn Bansuri online in live one-to-one lessons shaped around your experience, schedule, and musical goals.
            Classes combine practical flute technique with foundations in Indian classical music.
        </p>
        <div class="seo-grid">
            <article>
                <h2>Beginner Bansuri Classes</h2>
                <p>Learn posture, breath control, sound production, basic fingering, swara, and simple melodies.</p>
            </article>
            <article>
                <h2>Intermediate Lessons</h2>
                <p>Refine tone, coordination, rhythm, melodic movement, ornamentation, and confident playing.</p>
            </article>
            <article>
                <h2>Advanced Practice</h2>
                <p>Study phrasing, complex patterns, raga-based development, expression, and a mature personal voice.</p>
            </article>
        </div>
        <p class="seo-page-link"><NavLink href="contact">Ask about a first online lesson</NavLink></p>
    </main>

    <footer class="seo-page-footer">
        <nav class="seo-page seo-page-nav" aria-label="Footer navigation">
            <NavLink href="">Home</NavLink>
            <NavLink href="about">About Kuldeep</NavLink>
            <NavLink href="faq">Bansuri FAQ</NavLink>
        </nav>
    </footer>
</div>
