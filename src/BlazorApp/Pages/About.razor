@page "/about"

<SeoHead Title="About Kuldeep | Online Bansuri Teacher"
         Description="Meet Kuldeep Mishra, an online Bansuri teacher offering personalized Hindustani classical flute lessons to students worldwide."
         CanonicalUrl="https://flutewithkuldeep.com/about" />

<div class="seo-page-shell">
    <header class="seo-page-header">
        <nav class="seo-page seo-page-nav" aria-label="Main navigation">
            <NavLink href="">Home</NavLink>
            <NavLink href="classes">Classes</NavLink>
            <NavLink href="faq">FAQ</NavLink>
            <NavLink href="contact">Contact</NavLink>
        </nav>
    </header>

    <main class="seo-page seo-page-main">
        <h1>About Kuldeep</h1>
        <p>
            Kuldeep Mishra teaches Bansuri through patient, personalized online lessons rooted in Hindustani classical music.
            He has guided more than 250 students worldwide, including complete beginners and experienced musicians.
        </p>
        <section class="seo-page-card">
            <h2>A calm, traditional approach</h2>
            <p>
                Lessons focus on clear fundamentals, steady practice, careful listening, and a supportive learning environment.
                Students develop breath, tone, fingering, rhythm, melody, and personal expression without being rushed.
            </p>
        </section>
        <p class="seo-page-link"><NavLink href="classes">Explore online Bansuri classes</NavLink></p>
    </main>

    <footer class="seo-page-footer">
        <nav class="seo-page seo-page-nav" aria-label="Footer navigation">
            <NavLink href="">Home</NavLink>
            <NavLink href="classes">Classes</NavLink>
            <NavLink href="contact">Contact Kuldeep</NavLink>
        </nav>
    </footer>
</div>
